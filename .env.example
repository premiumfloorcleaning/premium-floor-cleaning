# Copy to .env.local and fill in. Never commit .env.local.
#
# ---------------------------------------------------------------------------
# Quote form email delivery — Resend (https://resend.com)
# ---------------------------------------------------------------------------
# Free plan: 3,000 emails/month, 100/day, 1 custom domain, 30-day log history.
# No SDK to install; the API route calls their REST endpoint with fetch.
#
# All three must be set together. If only some are set, the form returns an
# error instead of guessing — a lead sent to an address nobody watches is a
# lost lead, and that is worse than a visible failure.
#
# If none are set, the form's "Send on WhatsApp" button still works. It needs
# no configuration at all, because the message is sent from the visitor's own
# WhatsApp rather than from this server.

# Resend dashboard -> API Keys -> Create API Key ("Sending access" is enough).
RESEND_API_KEY=

# WHO RECEIVES THE ENQUIRY. This is your inbox — read this one, not the others.
# Any address works, including a plain Gmail; it does not need to be on your
# domain. Comma-separate to notify more than one person.
#   QUOTE_EMAIL_TO=you@gmail.com,office@premiumfloorcleaning.com
QUOTE_EMAIL_TO=

# WHO IT APPEARS TO COME FROM. This one is constrained: the domain must be
# verified in Resend, or every send is rejected. It is a label on the envelope,
# not a mailbox — nothing needs to be able to receive mail at this address, and
# it will not clash with the real GoDaddy mailboxes on the same domain.
# A Gmail address will NOT work here; you cannot prove you own gmail.com.
#
# Use the domain exactly as verified in Resend. The `send.` subdomain in the DNS
# records is Resend's bounce return-path, NOT the from-address.
#   QUOTE_EMAIL_FROM=quotes@premiumfloorcleaning.com
QUOTE_EMAIL_FROM=

# Replies: if the customer filled in their email, the route sets reply_to to it,
# so hitting Reply in your inbox answers the customer directly. Email is an
# optional field on the form, so when it is blank, Reply goes to the from
# address above instead.
